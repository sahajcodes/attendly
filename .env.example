# Copy this file to .env and fill in your own values.
# .env is private: never commit it to Git and never share it.

# 1. Supabase connection string
#    Supabase > Connect > Connection string > Session pooler
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# 2. College Wi-Fi public IP (or a range). Attendance is accepted only from these.
#    Leave it commented out and the check is OFF (the app prints a warning).
# ATTENDLY_ALLOWED_NETWORKS=203.0.113.10,198.51.100.0/24

# 3. Optional settings
# ATTENDLY_SECRET_KEY=
# ATTENDLY_PUBLIC_URL=
# ATTENDLY_HTTPS=0
